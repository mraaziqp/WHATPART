# Copy to .env for local development (values come from /opt/whatpart/.env on the VPS).
DATABASE_URL="postgresql://whatpart:PASSWORD@127.0.0.1:15432/whatpart"
MEILI_HOST="http://127.0.0.1:17700"
MEILI_MASTER_KEY=""
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Hide seeded demo sellers and their stock
SHOW_DEMO_SELLERS="true"

# PayFast: leave blank to use the shared public sandbox; set WHATPART's own account to test properly.
PAYFAST_SANDBOX="true"
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
PAYFAST_PASSPHRASE=""
