# WHATPART Marketplace — Environment Variables
# Copy this file to .env.local and fill in the values

# Database (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/whatpart"

# PayFast Payment Gateway
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
PAYFAST_PASSPHRASE=""
PAYFAST_SANDBOX="true"

# Ozow Instant EFT
OZOW_SITE_CODE=""
OZOW_PRIVATE_KEY=""
OZOW_API_KEY=""

# The Courier Guy API
TCG_API_KEY=""
TCG_ACCOUNT_NUMBER=""

# App Config
VITE_APP_URL="http://localhost:3000"
